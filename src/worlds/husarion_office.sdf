<?xml version="1.0"?>
<sdf version="1.9">
  <world name="husarion_office">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="ignition-gazebo-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.95 0.95 0.97 1</background>
      <grid>0</grid>
      <shadows>1</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="office_shell">
      <static>true</static>
      <link name="walls">
        <collision name="outer_north"><pose>0 6 1.25 0 0 0</pose><geometry><box><size>16 0.2 2.5</size></box></geometry></collision>
        <collision name="outer_south"><pose>0 -6 1.25 0 0 0</pose><geometry><box><size>16 0.2 2.5</size></box></geometry></collision>
        <collision name="outer_west"><pose>-8 0 1.25 0 0 0</pose><geometry><box><size>0.2 12 2.5</size></box></geometry></collision>
        <collision name="outer_east"><pose>8 0 1.25 0 0 0</pose><geometry><box><size>0.2 12 2.5</size></box></geometry></collision>

        <collision name="corridor_top_left"><pose>-4 2.5 1.25 0 0 0</pose><geometry><box><size>8 0.2 2.5</size></box></geometry></collision>
        <collision name="corridor_top_right"><pose>4 2.5 1.25 0 0 0</pose><geometry><box><size>6 0.2 2.5</size></box></geometry></collision>
        <collision name="corridor_bottom_left"><pose>-4 -2.5 1.25 0 0 0</pose><geometry><box><size>6 0.2 2.5</size></box></geometry></collision>
        <collision name="corridor_bottom_right"><pose>4 -2.5 1.25 0 0 0</pose><geometry><box><size>8 0.2 2.5</size></box></geometry></collision>

        <collision name="left_divider_top"><pose>-2.5 4.25 1.25 0 0 1.5708</pose><geometry><box><size>0.2 3.3 2.5</size></box></geometry></collision>
        <collision name="left_divider_bottom"><pose>-2.5 -4.25 1.25 0 0 1.5708</pose><geometry><box><size>0.2 3.3 2.5</size></box></geometry></collision>
        <collision name="right_divider_top"><pose>2.5 4.25 1.25 0 0 1.5708</pose><geometry><box><size>0.2 3.3 2.5</size></box></geometry></collision>
        <collision name="right_divider_bottom"><pose>2.5 -4.25 1.25 0 0 1.5708</pose><geometry><box><size>0.2 3.3 2.5</size></box></geometry></collision>
        <collision name="center_pillar"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>0.8 0.8 2.5</size></box></geometry></collision>

        <visual name="outer_north_v"><pose>0 6 1.25 0 0 0</pose><geometry><box><size>16 0.2 2.5</size></box></geometry><material><ambient>0.94 0.94 0.94 1</ambient><diffuse>0.94 0.94 0.94 1</diffuse></material></visual>
        <visual name="outer_south_v"><pose>0 -6 1.25 0 0 0</pose><geometry><box><size>16 0.2 2.5</size></box></geometry><material><ambient>0.94 0.94 0.94 1</ambient><diffuse>0.94 0.94 0.94 1</diffuse></material></visual>
        <visual name="outer_west_v"><pose>-8 0 1.25 0 0 0</pose><geometry><box><size>0.2 12 2.5</size></box></geometry><material><ambient>0.94 0.94 0.94 1</ambient><diffuse>0.94 0.94 0.94 1</diffuse></material></visual>
        <visual name="outer_east_v"><pose>8 0 1.25 0 0 0</pose><geometry><box><size>0.2 12 2.5</size></box></geometry><material><ambient>0.94 0.94 0.94 1</ambient><diffuse>0.94 0.94 0.94 1</diffuse></material></visual>
        <visual name="corridor_top_left_v"><pose>-4 2.5 1.25 0 0 0</pose><geometry><box><size>8 0.2 2.5</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="corridor_top_right_v"><pose>4 2.5 1.25 0 0 0</pose><geometry><box><size>6 0.2 2.5</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="corridor_bottom_left_v"><pose>-4 -2.5 1.25 0 0 0</pose><geometry><box><size>6 0.2 2.5</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="corridor_bottom_right_v"><pose>4 -2.5 1.25 0 0 0</pose><geometry><box><size>8 0.2 2.5</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="left_divider_top_v"><pose>-2.5 4.25 1.25 0 0 1.5708</pose><geometry><box><size>0.2 3.3 2.5</size></box></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
        <visual name="left_divider_bottom_v"><pose>-2.5 -4.25 1.25 0 0 1.5708</pose><geometry><box><size>0.2 3.3 2.5</size></box></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
        <visual name="right_divider_top_v"><pose>2.5 4.25 1.25 0 0 1.5708</pose><geometry><box><size>0.2 3.3 2.5</size></box></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
        <visual name="right_divider_bottom_v"><pose>2.5 -4.25 1.25 0 0 1.5708</pose><geometry><box><size>0.2 3.3 2.5</size></box></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
        <visual name="center_pillar_v"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>0.8 0.8 2.5</size></box></geometry><material><ambient>0.75 0.75 0.77 1</ambient><diffuse>0.75 0.75 0.77 1</diffuse></material></visual>
      </link>
    </model>

    <model name="desk_cluster_nw">
      <static>true</static>
      <link name="desk">
        <collision name="desk_a"><pose>-5.5 4.5 0.4 0 0 0</pose><geometry><box><size>1.8 0.8 0.8</size></box></geometry></collision>
        <collision name="desk_b"><pose>-6.5 3.5 0.4 0 0 0</pose><geometry><box><size>1.2 0.8 0.8</size></box></geometry></collision>
        <visual name="desk_a_v"><pose>-5.5 4.5 0.4 0 0 0</pose><geometry><box><size>1.8 0.8 0.8</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.55 0.42 0.28 1</diffuse></material></visual>
        <visual name="desk_b_v"><pose>-6.5 3.5 0.4 0 0 0</pose><geometry><box><size>1.2 0.8 0.8</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.55 0.42 0.28 1</diffuse></material></visual>
      </link>
    </model>

    <model name="meeting_room_table">
      <static>true</static>
      <link name="table">
        <collision name="table_top"><pose>5.0 4.0 0.45 0 0 0</pose><geometry><box><size>2.8 1.2 0.9</size></box></geometry></collision>
        <visual name="table_top_v"><pose>5.0 4.0 0.45 0 0 0</pose><geometry><box><size>2.8 1.2 0.9</size></box></geometry><material><ambient>0.48 0.34 0.22 1</ambient><diffuse>0.48 0.34 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="kitchenette">
      <static>true</static>
      <link name="kitchen">
        <collision name="counter"><pose>5.8 -4.7 0.5 0 0 0</pose><geometry><box><size>3.4 0.7 1.0</size></box></geometry></collision>
        <collision name="island"><pose>4.5 -3.8 0.45 0 0 0</pose><geometry><box><size>1.0 0.9 0.9</size></box></geometry></collision>
        <visual name="counter_v"><pose>5.8 -4.7 0.5 0 0 0</pose><geometry><box><size>3.4 0.7 1.0</size></box></geometry><material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.7 0.72 0.75 1</diffuse></material></visual>
        <visual name="island_v"><pose>4.5 -3.8 0.45 0 0 0</pose><geometry><box><size>1.0 0.9 0.9</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual>
      </link>
    </model>

    <model name="storage_racks">
      <static>true</static>
      <link name="racks">
        <collision name="rack_1"><pose>-5.8 -4.6 0.6 0 0 0</pose><geometry><box><size>0.7 2.0 1.2</size></box></geometry></collision>
        <collision name="rack_2"><pose>-4.6 -4.4 0.6 0 0 1.5708</pose><geometry><box><size>0.7 1.4 1.2</size></box></geometry></collision>
        <visual name="rack_1_v"><pose>-5.8 -4.6 0.6 0 0 0</pose><geometry><box><size>0.7 2.0 1.2</size></box></geometry><material><ambient>0.44 0.46 0.49 1</ambient><diffuse>0.44 0.46 0.49 1</diffuse></material></visual>
        <visual name="rack_2_v"><pose>-4.6 -4.4 0.6 0 0 1.5708</pose><geometry><box><size>0.7 1.4 1.2</size></box></geometry><material><ambient>0.44 0.46 0.49 1</ambient><diffuse>0.44 0.46 0.49 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
